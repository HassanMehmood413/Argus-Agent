# ===========================================
# Kubernetes Secrets - NEVER commit these!
# ===========================================
# Pattern-based (catches all secrets/sensitive configs)
**/secrets.yml
**/secrets.yaml
**/secret.yml
**/secret.yaml
**/*-secret.yml
**/*-secret.yaml
**/*-secrets.yml
**/*-secrets.yaml

# ConfigMaps with sensitive data
**/configMapRef.yml
**/configMapRef.yaml

# Specific paths (explicit)
k8s/backend/agent/secrets.yml
k8s/backend/agent/configMapRef.yml
k8s/backend/db/postgres-secret.yml
